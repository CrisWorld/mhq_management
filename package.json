{
  "name": "mhq-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 0.0.0.0\" \"tsx watch server/local.ts\"",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx scripts/test-database.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:live": "tsx scripts/test-live.ts",
    "format": "prettier --write src server shared api tests scripts *.json *.ts",
    "format:check": "prettier --check src server shared api tests scripts *.json *.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@supabase/supabase-js": "^2.118.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "overrides": {
    "multer": "^2.4.1"
  }
}
